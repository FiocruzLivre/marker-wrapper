{
    "name": "fiocruzlivre/marker-wrapper",
    "description": "Configurable tile, static map and marker gateway",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": "^8.5",
        "ext-imagick": "*",
        "ext-dom": "*",
        "guzzlehttp/guzzle": "^8.3.1"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.9.1"
    },
    "autoload": {
        "psr-4": {
            "FiocruzLivre\\MarkerWrapper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FiocruzLivre\\MarkerWrapper\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "classmap-authoritative": true,
        "sort-packages": true,
        "audit": {
            "block-insecure": true
        },
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true
        }
    },
    "scripts": {
        "lint": "find src public tests bin -name '*.php' -print0 | xargs -0 -n1 php -l",
        "test": "vendor-bin/phpunit/vendor/bin/phpunit --configuration phpunit.xml",
        "cs:check": "vendor-bin/coding-standard/vendor/bin/php-cs-fixer fix --dry-run --diff --using-cache=no",
        "cs:fix": "vendor-bin/coding-standard/vendor/bin/php-cs-fixer fix --using-cache=no",
        "psalm": "vendor-bin/psalm/vendor/bin/psalm --no-progress --threads=1",
        "psalm:clear": "vendor-bin/psalm/vendor/bin/psalm --clear-cache",
        "tools:install": [
            "composer bin all install --no-interaction",
            "composer --working-dir=vendor-bin/phpunit install --no-interaction",
            "composer --working-dir=vendor-bin/psalm install --no-interaction",
            "composer --working-dir=vendor-bin/coding-standard install --no-interaction"
        ],
        "cache:prune": "php bin/prune-cache.php",
        "security:check": "composer audit --locked --no-interaction"
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": true
        }
    }
}
