{
    "name": "fiocruzlivre/marker-wrapper",
    "description": "Restricted Kartographer tile and marker gateway",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": "^8.5",
        "ext-imagick": "*",
        "ext-dom": "*",
        "guzzlehttp/guzzle": "^7.10"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "FiocruzLivre\\MarkerWrapper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FiocruzLivre\\MarkerWrapper\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "classmap-authoritative": true,
        "sort-packages": true,
        "audit": {
            "block-insecure": true
        }
    },
    "scripts": {
        "lint": "find src public tests -name '*.php' -print0 | xargs -0 -n1 php -l",
        "test": "phpunit --configuration phpunit.xml",
        "audit": "composer audit --locked"
    }
}
