# Use an approved provider and your own identifiable service contact.
TILE_SERVER=https://tiles.example.org
MARKER_USER_AGENT=MarkerWrapper/2.0 (+https://example.org/contact)
# Optional; leave empty if the provider does not require a referring site.
MARKER_REFERER=
# Cache lifetime in seconds; tile default 7d, static maps 1d, markers 30d.
TILE_CACHE_TTL=604800
STATIC_CACHE_TTL=86400
MARKER_CACHE_TTL=2592000
